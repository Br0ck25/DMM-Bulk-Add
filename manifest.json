{
  "manifest_version": 3,
  "name": "DMM Bulk Add",
  "version": "1.3.2",
  "description": "Adds select-all + bulk add to your DMM library from IMDb, Letterboxd, MDBList, Trakt, TMDB and TheTVDB lists, auto-tracked links, all-seasons TV handling, and a scheduled full-library reinsert sweep.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://www.imdb.com/*",
    "https://m.imdb.com/*",
    "https://letterboxd.com/*",
    "https://mdblist.com/*",
    "https://trakt.tv/*",
    "https://www.themoviedb.org/*",
    "https://www.thetvdb.com/*",
    "https://debridmediamanager.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.imdb.com/*",
        "https://m.imdb.com/*",
        "https://letterboxd.com/*",
        "https://mdblist.com/*",
        "https://trakt.tv/*",
        "https://www.themoviedb.org/*",
        "https://www.thetvdb.com/*"
      ],
      "js": ["shared.js", "site-adapters.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://debridmediamanager.com/*"],
      "js": ["dmm-autopick.js"],
      "css": ["dmm-autopick.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://debridmediamanager.com/library*"],
      "js": ["dmm-library-refresh.js"],
      "run_at": "document_idle"
    }
  ]
}
